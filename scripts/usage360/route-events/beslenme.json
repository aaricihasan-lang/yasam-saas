{
  "module": "beslenme",
  "handlers": [
    { "route": "beslenme/plans", "method": "POST", "events": [{ "action": "record_created", "subEntity": "plan" }], "failure": "server" },
    { "route": "beslenme/plans/[id]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "plan" }], "failure": "server", "note": "PLAN_STALE 409 → conflict" },
    { "route": "beslenme/plans/[id]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "plan" }], "failure": "server", "note": "gerçek revizyon silme (arşiv yok)" },
    { "route": "beslenme/plans/[id]/copy", "method": "POST", "events": [{ "action": "record_created", "subEntity": "plan" }], "failure": "server", "note": "kopya YENİ aile üretir" },
    { "route": "beslenme/plans/[id]/revise", "method": "POST", "events": [{ "action": "record_created", "subEntity": "plan" }], "failure": "server", "note": "revizyon YENİ plan satırı (aynı aile, revision+1)" },
    { "route": "beslenme/plans/[id]/range", "method": "POST", "events": [{ "action": "record_updated", "subEntity": "plan" }], "failure": "server" },
    { "route": "beslenme/plans/[id]/week-copy", "method": "POST", "events": [{ "action": "record_updated", "subEntity": "plan" }], "failure": "server", "note": "çok-günlü → plan; tek olay + itemCount=gün" },
    { "route": "beslenme/plans/[id]/refresh-snapshots", "method": "POST", "events": [{ "action": "record_updated", "subEntity": "plan" }], "failure": "server", "note": "tek olay + itemCount; 0 güncelleme = no-op olay yok" },
    { "route": "beslenme/plans/[id]/assign-client", "method": "POST", "events": [{ "action": "record_created", "subEntity": "assignment" }], "failure": "server", "note": "aynı danışana tekrar = RPC idempotent, binding id ile kalıcı dedup" },
    { "route": "beslenme/plans/[id]/word", "method": "POST", "events": [{ "action": "report_generated", "subEntity": "plan" }], "failure": "server" },
    { "route": "beslenme/plans/[id]/days/[dayId]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "day" }], "failure": "server" },
    { "route": "beslenme/plans/[id]/days/[dayId]/clear", "method": "POST", "events": [{ "action": "record_updated", "subEntity": "day" }], "failure": "server", "note": "günü temizle: tek olay + itemCount=öğün; boş gün = no-op" },
    { "route": "beslenme/plans/[id]/days/[dayId]/clear/challenge", "method": "POST", "exempt": "onay/challenge: yalnız 4 haneli doğrulama kodu üretir, iş verisi değişmez" },
    { "route": "beslenme/plans/[id]/days/[dayId]/copy", "method": "POST", "events": [{ "action": "record_updated", "subEntity": "day" }], "failure": "server", "note": "tek-gün hedefi → day (hedef gün)" },
    { "route": "beslenme/plans/[id]/days/[dayId]/meals", "method": "POST", "events": [{ "action": "record_created", "subEntity": "meal" }], "failure": "server" },
    { "route": "beslenme/plans/[id]/meals/[mealId]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "meal" }], "failure": "server" },
    { "route": "beslenme/plans/[id]/meals/[mealId]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "meal" }], "failure": "server" },
    { "route": "beslenme/plans/[id]/meals/[mealId]/copy", "method": "POST", "events": [{ "action": "record_created", "subEntity": "meal" }], "failure": "server", "note": "hedef güne YENİ öğün" },
    { "route": "beslenme/plans/[id]/meals/[mealId]/items", "method": "POST", "events": [{ "action": "record_created", "subEntity": "item" }], "failure": "server" },
    { "route": "beslenme/plans/[id]/meals/reorder", "method": "POST", "events": [{ "action": "record_updated", "subEntity": "meal" }], "failure": "server", "note": "sıralama: tek olay + itemCount" },
    { "route": "beslenme/plans/[id]/items/[itemId]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "item" }], "failure": "server", "note": "taşıma veya miktar düzenleme (iki başarı dalı, her biri tek olay)" },
    { "route": "beslenme/plans/[id]/items/[itemId]", "method": "PUT", "events": [{ "action": "record_updated", "subEntity": "item" }], "failure": "server" },
    { "route": "beslenme/plans/[id]/items/[itemId]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "item" }], "failure": "server" },
    { "route": "beslenme/plans/[id]/items/[itemId]/copy", "method": "POST", "events": [{ "action": "record_created", "subEntity": "item" }], "failure": "server" },
    { "route": "beslenme/foods", "method": "POST", "events": [{ "action": "record_created", "subEntity": "food" }], "failure": "server" },
    { "route": "beslenme/foods/quick", "method": "POST", "events": [{ "action": "record_created", "subEntity": "food" }], "failure": "server", "note": "besin+değer+porsiyon tek olay" },
    { "route": "beslenme/foods/[id]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "food" }], "failure": "server" },
    { "route": "beslenme/foods/[id]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "food" }], "failure": "server", "note": "IN_USE 409 → conflict" },
    { "route": "beslenme/foods/[id]/nutrients", "method": "PUT", "events": [{ "action": "record_updated", "subEntity": "food" }], "failure": "server" },
    { "route": "beslenme/foods/[id]/portions", "method": "PUT", "events": [{ "action": "record_updated", "subEntity": "food" }], "failure": "server" },
    { "route": "beslenme/foods/[id]/traditional", "method": "PUT", "events": [{ "action": "record_updated", "subEntity": "food" }], "failure": "server" },
    { "route": "beslenme/foods/[id]/sources", "method": "POST", "events": [{ "action": "record_created", "subEntity": "source_link" }], "failure": "server" },
    { "route": "beslenme/foods/[id]/sources/[linkId]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "source_link" }], "failure": "server" },
    { "route": "beslenme/foods/reset", "method": "POST", "events": [{ "action": "record_updated", "subEntity": "food" }], "failure": "server", "note": "kişiselleştirmeyi sıfırla: tek olay + itemCount; 0 = no-op" },
    { "route": "beslenme/foods/reset/challenge", "method": "POST", "exempt": "onay/challenge: yalnız doğrulama kodu + kapsam önizlemesi üretir" },
    { "route": "beslenme/sources", "method": "POST", "events": [{ "action": "record_created", "subEntity": "source" }], "failure": "server" },
    { "route": "beslenme/sources/[id]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "source" }], "failure": "server" },
    { "route": "beslenme/sources/[id]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "source" }], "failure": "server", "note": "IN_USE 409 → conflict" },
    { "route": "beslenme/topics", "method": "POST", "events": [{ "action": "record_created", "subEntity": "topic" }], "failure": "server" },
    { "route": "beslenme/topics/[id]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "topic" }], "failure": "server" },
    { "route": "beslenme/topics/[id]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "topic" }], "failure": "server" },
    { "route": "beslenme/topics/[id]/sections", "method": "POST", "events": [{ "action": "record_created", "subEntity": "section" }], "failure": "server" },
    { "route": "beslenme/topics/[id]/sections/[sectionId]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "section" }], "failure": "server" },
    { "route": "beslenme/topics/[id]/sections/[sectionId]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "section" }], "failure": "server" },
    { "route": "beslenme/topics/[id]/foods", "method": "POST", "events": [{ "action": "record_updated", "subEntity": "topic" }], "failure": "server", "note": "rehbere besin bağlama = rehber değişikliği (kaynak bağı değil)" },
    { "route": "beslenme/topics/[id]/foods/[relId]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "topic" }], "failure": "server" },
    { "route": "beslenme/topics/[id]/foods/[relId]", "method": "DELETE", "events": [{ "action": "record_updated", "subEntity": "topic" }], "failure": "server", "note": "bağ kaldırma = rehber değişikliği; besin silinmez" },
    { "route": "beslenme/topics/[id]/sources", "method": "POST", "events": [{ "action": "record_created", "subEntity": "source_link" }], "failure": "server" },
    { "route": "beslenme/topics/[id]/sources/[linkId]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "source_link" }], "failure": "server" },
    { "route": "beslenme/templates", "method": "POST", "events": [{ "action": "record_created", "subEntity": "template" }], "failure": "server" },
    { "route": "beslenme/templates/[id]", "method": "PATCH", "events": [{ "action": "record_updated", "subEntity": "template" }], "failure": "server" },
    { "route": "beslenme/templates/[id]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "template" }], "failure": "server" },
    { "route": "beslenme/templates/[id]/apply", "method": "POST", "events": [{ "action": "record_updated", "subEntity": "plan" }], "failure": "server", "note": "hedef plan içeriği değişir" },
    { "route": "beslenme/templates/[id]/duplicate", "method": "POST", "events": [{ "action": "record_created", "subEntity": "template" }], "failure": "server" },
    { "route": "beslenme/clients/[clientId]/plans", "method": "POST", "events": [{ "action": "record_created", "subEntity": "plan" }], "failure": "server", "note": "create + bind tek olay; clients izni ile" },
    { "route": "beslenme/clients/[clientId]/measurements", "method": "POST", "events": [{ "action": "record_created", "subEntity": "measurement" }], "failure": "server" },
    { "route": "beslenme/clients/[clientId]/measurements/[measurementId]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "measurement" }], "failure": "server" },
    { "route": "beslenme/clients/[clientId]/preferences", "method": "POST", "events": [{ "action": "record_created", "subEntity": "preference" }], "failure": "server" },
    { "route": "beslenme/clients/[clientId]/preferences/[preferenceId]", "method": "DELETE", "events": [{ "action": "record_deleted", "subEntity": "preference" }], "failure": "server" },
    { "route": "beslenme/clients/[clientId]/allergens", "method": "PUT", "events": [{ "action": "record_updated", "subEntity": "allergen" }], "failure": "server", "note": "tam-set değişimi tek olay" },
    { "route": "beslenme/clients/[clientId]/profile", "method": "PUT", "events": [{ "action": "record_updated", "subEntity": "profile" }], "failure": "server", "note": "upsert → record_updated" }
  ]
}
